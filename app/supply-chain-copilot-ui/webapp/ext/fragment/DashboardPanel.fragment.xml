<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout">

    <VBox id="stDashboardPanel" class="stDashboardKpiPanel">
        <HBox class="stDashboardHeader">
            <VBox class="stDashboardHeaderLeft" wrappingType="Normal">
                <Title text="📊 Tedarik Zinciri Dashboard" level="H2" class="stDashboardTitle"/>
                <Text text="Mağaza stok özeti ve analitik göstergeler" class="stDashboardSubtitle"/>
            </VBox>
            <core:HTML content="&lt;div class='stNttBadge'&gt;&lt;svg class='stNttLogo' viewBox='0 0 120 36' xmlns='http://www.w3.org/2000/svg'&gt;&lt;rect width='120' height='36' rx='6' fill='#003087'/&gt;&lt;text x='8' y='14' font-family='Arial,sans-serif' font-size='11' font-weight='900' fill='#fff' letter-spacing='1'&gt;NTT DATA&lt;/text&gt;&lt;text x='8' y='28' font-family='Arial,sans-serif' font-size='7.5' fill='#7eb3f5' letter-spacing='0.3'&gt;Business Solutions&lt;/text&gt;&lt;circle cx='108' cy='18' r='7' fill='#e4002b'/&gt;&lt;circle cx='108' cy='18' r='4' fill='#fff'/&gt;&lt;circle cx='108' cy='18' r='2' fill='#e4002b'/&gt;&lt;/svg&gt;&lt;/div&gt;"/>
        </HBox>

        <!-- KPI Grid -->
        <FlexBox wrap="Wrap" class="stKpiGrid" id="stKpiGrid"/>

        <!-- Spark Rows -->
        <VBox class="stSparkSection">
            <Text text="Mağaza Bazlı Stok Dağılımı" class="stSparkSection__title"/>
            <VBox id="stSparkRows"/>
        </VBox>

        <!-- Charts -->
        <Text text="📈 Analitik Grafikler" class="stChartSectionTitle"/>
        <FlexBox wrap="Wrap" class="stChartsGrid" id="stChartsGrid"/>
    </VBox>

</core:FragmentDefinition>
